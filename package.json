{
  "name": "netzen-web-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dashboard": "vite --config vite.dashboard.config.js",
    "build": "vite build",
    "build:standalone": "vite build --mode standalone",
    "build:dashboard": "vite build --config vite.dashboard.config.js",
    "build:dashboard:standalone": "vite build --config vite.dashboard.config.js --mode standalone",
    "entregable": "vite build --mode standalone && node scripts/make-entregable.mjs",
    "entregable:dashboard": "vite build --config vite.dashboard.config.js --mode standalone && node scripts/make-dashboard-entregable.mjs",
    "entregable:all": "npm run entregable && npm run entregable:dashboard",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
